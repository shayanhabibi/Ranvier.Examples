<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <RanvierTrace Condition="'$(RanvierTrace)' == '' and '$(Configuration)' == 'Debug'">true</RanvierTrace>
    <RanvierTrace Condition="'$(RanvierTrace)' == ''">false</RanvierTrace>
    <DefineConstants Condition="'$(RanvierTrace)' == 'true'">$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shop.fs" />
    <Compile Include="Recording.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../external/Ranvier/src/Ranvier.Persistence/Ranvier.Persistence.fsproj" />
  </ItemGroup>
</Project>
